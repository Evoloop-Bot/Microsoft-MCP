# Microsoft 365 MCP Server — local configuration reference
# Copy this file to .env and fill in your values. Never commit .env to source control.

# ── Required ───────────────────────────────────────────────────────────────────

# Entra application (client) ID registered in Azure Active Directory.
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Tenant ID. Use "common" for multi-tenant apps (personal + work accounts).
# For a single-org deployment, use your directory (tenant) ID instead.
MICROSOFT_TENANT_ID=common

# ── Auth flow ──────────────────────────────────────────────────────────────────

# Only device_code is supported for the pilot. The server prints a browser URL
# and one-time code to stderr on first run; follow the prompt to sign in.
# Tokens are cached in a user-scoped MSAL cache so silent token refresh works
# across calls and across server restarts.
MICROSOFT_AUTH_FLOW=device_code

# Optional: override the persisted MSAL cache location. Defaults to a user-scoped
# path such as ~/.m365-mcp/msal-cache.json when not specified.
# MICROSOFT_TOKEN_CACHE_PATH=/home/you/.m365-mcp/msal-cache.json

# Optional Linux-only escape hatch for environments without libsecret.
# Leave this false in normal deployments; plaintext cache fallback is less secure.
# MICROSOFT_TOKEN_CACHE_USE_PLAINTEXT_FALLBACK=false

# ── Capabilities ──────────────────────────────────────────────────────────────

# Comma-separated list of capability domains to enable.
# Controls the default MCP tools that register at startup.
# Allowed: mail, calendar, files, people
# Note: files capability is scoped to the signed-in user's OneDrive only for
# this pilot. SharePoint drive access requires allowlist enforcement (not yet
# implemented) and should not be included in pilot configs.
MICROSOFT_ENABLED_CAPABILITIES=mail,calendar,files,people

# Optional: override the default tool set with an explicit least-privilege list.
# When set, tool registration and derived OAuth scopes come from this list instead
# of the broader capability defaults.
# MICROSOFT_ENABLED_TOOLS=mail_list_messages,people_search

# ── Graph API ─────────────────────────────────────────────────────────────────

MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Override OAuth scopes (comma-separated). Defaults to capability-derived scopes.
# Uncomment and edit only if you need a custom scope set.
# MICROSOFT_GRAPH_SCOPES=User.Read,Mail.Read,Mail.Send,Calendars.Read,Calendars.ReadWrite,Files.Read,People.Read

# ── HTTP tuning ───────────────────────────────────────────────────────────────

MICROSOFT_HTTP_TIMEOUT_MS=15000
MICROSOFT_MAX_RETRIES=3
MICROSOFT_RETRY_BASE_DELAY_MS=500
